          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/subscriptions", "host": ["{{base_url}}"], "path": ["subscriptions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BadSub\",\n  \"price\": 10,\n  \"currency\": \"USD\",\n  \"frequency\": \"biweekly\",\n  \"category\": \"entertainment\",\n  \"startDate\": \"2026-10-01T00:00:00.000Z\",\n  \"renewalDate\": \"2026-11-01T00:00:00.000Z\",\n  \"user\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Get Subscription by ID",
