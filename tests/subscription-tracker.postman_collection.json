            ],
            "url": { "raw": "{{base_url}}/subscriptions/{{sub_id}}", "host": ["{{base_url}}"], "path": ["subscriptions", "{{sub_id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 19.99\n}"
            }
          }
        },
        {
          "name": "Cancel Subscription",
          "event": [
