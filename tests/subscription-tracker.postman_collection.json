            "url": { "raw": "{{base_url}}/subscriptions", "host": ["{{base_url}}"], "path": ["subscriptions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Netflix\",\n  \"price\": 15.99,\n  \"currency\": \"USD\",\n  \"frequency\": \"monthly\",\n  \"category\": \"entertainment\",\n  \"status\": \"active\",\n  \"startDate\": \"2026-10-01T00:00:00.000Z\",\n  \"renewalDate\": \"2026-11-01T00:00:00.000Z\",\n  \"user\": \"{{user_id}}\"\n}"
            }
          }
        },
